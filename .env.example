# ==============================================================================
# Stack Docker : mots de passe des bases (obligatoires)
# ==============================================================================
# Generer chacun avec : openssl rand -hex 24
# Hexadecimal : ils sont inseres dans des URL de connexion, ou @ / : les casseraient.
POSTGRES_PASSWORD=
OPENFGA_POSTGRES_PASSWORD=

# ==============================================================================
# Reseau
# ==============================================================================
APP_GRPC_ADDR=:50051
APP_HTTP_ADDR=:8080
# Requetes par seconde et par adresse IP, gRPC et REST (le double en rafale) ; 0 = sans limite.
APP_RATE_LIMIT_RPS=100

# ==============================================================================
# Base de donnees et cache
# ==============================================================================
APP_DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@localhost:5432/music_room?sslmode=disable
APP_REDIS_ADDR=localhost:6379
APP_REDIS_DB=0

# ==============================================================================
# Authentification
# ==============================================================================
# Plancher absolu de 8 : une valeur inferieure est ramenee a 8.
APP_MIN_PASSWORD_LENGTH=8

# Duree de vie absolue d'une session.
APP_SESSION_TTL_DAYS=30

# Duree d'inactivite apres laquelle une session est refusee (avant l'absolue).
APP_SESSION_IDLE_DAYS=7

# Duree de vie du code de verification email.
APP_EMAIL_CODE_TTL_MINUTES=15

# Essais autorises par code avant invalidation.
APP_CODE_MAX_ATTEMPTS=5

# ==============================================================================
# Mailer
# ==============================================================================
# log: mail ecrit dans les logs, smtp: mail envoye via le serveur SMTP
APP_MAILER=log

APP_SMTP_HOST=smtp.example.com
APP_SMTP_PORT=587
APP_SMTP_USERNAME=user@example.com
APP_SMTP_PASSWORD=changeme

# Adresse visible par les destinataires
APP_SMTP_FROM=Music Room <noreply@example.com>

# ==============================================================================
# Avatars (image-service)
# ==============================================================================
# Base URL du microservice Rust de resize (docker-compose: image-service).
APP_IMAGE_SERVICE_URL=http://localhost:8080
# Repertoire local ou sont ecrits les fichiers uploades (originaux + miniatures) ;
# servi tel quel sous /media/ (voir cmd/main.go).
APP_IMAGE_STORAGE_DIR=data/images

# ==============================================================================
# OAuth
# ==============================================================================
# Un provider sans identifiants n'est pas enregistre.
#
# URL de redirection a declarer chez chaque provider : l'adresse publique de la
# passerelle HTTP + /oauth/callback (en local : http://localhost:8081/oauth/callback).
# Cette page renvoie le code vers l'app (APP_OAUTH_APP_CALLBACK), qui doit avoir
# la meme valeur dans OAUTH_REDIRECT_URI (frontend/app/.env).
APP_OAUTH_APP_CALLBACK=musicroom://oauth
APP_OAUTH_GOOGLE_CLIENT_ID=817547243405-c7pq0ds8qcb9jqh28db5mq91b3i3uv1t.apps.googleusercontent.com
APP_OAUTH_GOOGLE_CLIENT_SECRET=
APP_OAUTH_INTRA42_CLIENT_ID=u-s4t2ud-e9e28a889b96d50f6f3c2cb41e7b1d1fccb0e9453ea9e08b324629f6d7190ff2
APP_OAUTH_INTRA42_CLIENT_SECRET=