# Configuration de l'app Flutter. Lue a la COMPILATION (String.fromEnvironment,
# lib/globals/app_constants.dart), pas au demarrage : il faut la passer
# explicitement, sinon ce sont les valeurs par defaut du code qui s'appliquent.
#
#   flutter run --dart-define-from-file=.env

# Backend gRPC (natif). 50051 par defaut, 8081 pour la passerelle REST.
BACKEND_HOST=localhost
BACKEND_PORT=50051

# Serveur HTTP du backend (passerelle REST, /media/ pour les avatars). 8081
# avec docker compose ; 8080 si le backend tourne via `make backend`.
BACKEND_HTTP_PORT=8081

# TLS sur le canal gRPC. false en local (le backend ecoute en clair).
BACKEND_SECURE_CREDENTIALS=false

# Token de session utilise en debug quand rien n'est stocke, pour travailler
# sur les ecrans derriere le login sans se connecter a chaque run : obtenir un
# token une fois via grpcurl (AuthService/Login) et le coller ici. Ignore en
# release. Voir docs/auth-client.md.
DEV_SESSION_TOKEN=

# ==============================================================================
# OAuth ("Continue with Google / 42", docs/auth-client.md)
# ==============================================================================
# Client IDs publics des apps enregistrees chez chaque provider (les secrets
# restent cote backend : APP_OAUTH_*_CLIENT_SECRET). Vide = bouton desactive.
# A REMPLIR une fois les apps enregistrees.
OAUTH_GOOGLE_CLIENT_ID=817547243405-c7pq0ds8qcb9jqh28db5mq91b3i3uv1t.apps.googleusercontent.com
OAUTH_INTRA42_CLIENT_ID=u-s4t2ud-e9e28a889b96d50f6f3c2cb41e7b1d1fccb0e9453ea9e08b324629f6d7190ff2

# Page de rebond du backend, a declarer A L IDENTIQUE chez chaque provider.
# En local : la passerelle HTTP du backend. Sur un telephone ou un emulateur
# Android, localhost ne pointe pas vers la machine de dev : utiliser une URL
# joignable (tunnel https, voir docs/auth-client.md).
OAUTH_REDIRECT_URI=http://localhost:8081/oauth/callback
